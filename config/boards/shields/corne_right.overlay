#include <dt-bindings/led/led.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <6>;
        // Add `map = <RC(r,c) ...>;` only if your wiring/layout differs from the standard 5x6 grid.
    };

    soft_off: soft_off {
        compatible = "zmk,soft-off";
        hold-time-ms = <3000>;
    };

    vbatt1: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

    kscan1: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        row-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios = <&gpio0 6  GPIO_ACTIVE_HIGH>,
                    <&gpio0 8  GPIO_ACTIVE_HIGH>,
                    <&gpio0 41 GPIO_ACTIVE_HIGH>,
                    <&gpio0 30 GPIO_ACTIVE_HIGH>,
                    <&gpio0 45 GPIO_ACTIVE_HIGH>,
                    <&gpio0 13 GPIO_ACTIVE_HIGH>;

        diode-direction = "col2row";
        wakeup-source;
    };

    chosen {
        zmk,matrix-transform = &default_transform;
        zmk,battery = &vbatt1;
        zmk,underglow = &led_strip;
        zephyr,display = &oled_right;
    };
};

/* 128x32 SSD1306 display on I2C0 @ 0x3c (common default).
 * If nothing shows on this side, change reg to <0x3d>.
 */
&i2c0 {
    status = "okay";

    oled_right: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};

/* Override the upstream Corne shield's default chain-length = 10.
 * The built-in nice_nano board+shield overlay defines led_strip on SPI3/P0.06.
 * We only need to override chain-length here.
 */
&led_strip {
    chain-length = <24>; /* 18 per-key + 6 underglow per side */
};
