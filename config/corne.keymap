#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    tapping-term-ms = <250>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// ┌─────────────┬───────────┬───────────┬─────────────┬───────────┬─────────────┐       ┌──────────┬───────────┬───────────┬──────────┬───────────┬─────────────┐
// │             │     Q     │     W     │      E      │     R     │      T      │       │    Y     │     U     │     I     │    O     │     P     │             │
// ├─────────────┼───────────┼───────────┼─────────────┼───────────┼─────────────┤       ├──────────┼───────────┼───────────┼──────────┼───────────┼─────────────┤
// │             │ mt lgui A │ mt lalt S │  mt lctl D  │ mt lsft F │      G      │       │    H     │ mt rsft J │ mt rctl K │ mt ralt L│  mt rgui ;│             │
// ├─────────────┼───────────┼───────────┼─────────────┼───────────┼─────────────┤       ├──────────┼───────────┼───────────┼──────────┼───────────┼─────────────┤
// │             │     Z     │     X     │      C      │     V     │      B      │       │    N     │     M     │     ,     │    .     │     /     │             │
// └─────────────┴───────────┴───────────┼─────────────┼───────────┼─────────────┤       ├──────────┼───────────┼───────────┼──────────┴───────────┴─────────────┘
//                                       │     ESC     │   mo 1    │     TAB     │       │   ENT    │ lt 1 SPC  │ lt 2 BSPC │
//                                       └─────────────┴───────────┴─────────────┘       └──────────┴───────────┴───────────┘
   &trans   &kp Q          &kp W        &kp E          &kp R          &kp T                   &kp Y       &kp U          &kp I         &kp O        &kp P             &trans
   &trans   &mt LGUI A     &mt LALT S   &mt LCTRL D    &mt LSHIFT F   &kp G                   &kp H       &mt RSHIFT J   &mt RCTRL K   &mt RALT L   &mt RGUI SEMI     &trans
   &trans   &kp Z          &kp X        &kp C          &kp V          &kp B                   &kp N       &kp M          &kp COMMA     &kp DOT      &kp FSLH          &trans
                                        &kp ESC        &mo 1          &kp TAB                 &kp ENTER   &lt 2 SPACE    &lt 3 BSPC
            >;
        };

        lower_layer {
            bindings = <
   &trans   &kp GRAVE   &kp N7   &kp N8   &kp N9   &none           &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp SQT     &trans
   &trans   &kp N0      &kp N4   &kp N5   &kp N6   &none           &none       &kp RSHIFT  &kp RCTRL   &kp RALT    &kp RGUI    &trans
   &trans   &none       &kp N1   &kp N2   &kp N3   &none           &none       &none       &none       &none       &none       &trans
                                 &trans   &trans   &trans          &trans      &trans      &trans
            >;
        };

        raise_layer {
            bindings = <
   &trans   &kp GRAVE   &kp N7   &kp N8      &kp N9   &none           &kp MINUS   &kp EQUAL   &kp LBKT   &kp RBKT    &kp BSLH    &trans
   &trans   &kp N0      &kp N4   &kp N5      &kp N6   &none           &none       &kp RSHIFT  &kp RCTRL  &kp RALT    &kp RGUI    &trans
   &trans   &none       &kp N1   &kp N2      &kp N3   &none           &none       &none       &none      &none       &none       &trans
                                 &trans      &trans   &trans          &trans      &trans      &trans
            >;
        };

        adjust_layer {
            bindings = <
   &trans   &kp F1        &kp F2       &kp F3            &kp F4            &kp F5                  &kp F6            &kp F7                &kp F8                &kp F9       &kp F10       &trans
   &trans   &kp F11       &kp F12      &bt BT_SEL 2      &bt BT_SEL 1      &bt BT_SEL 0            &kp C_PP          &kp C_VOL_UP          &kp C_VOL_DN          &kp C_NEXT   &kp C_PREV    &trans
   &trans   &bootloader   &sys_reset   &bt BT_CLR        &studio_unlock    &soft_off               &none             &none                 &none                 &sys_reset   &bootloader   &trans
                                       &trans             &trans            &trans                  &trans            &trans                &trans
            >;
        };
    };
};

