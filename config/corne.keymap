#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

&mt {
    tapping-term-ms = <250>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
// ┌──────┬───────────┬───────────┬────────────┬────────────┬─────┐       ┌─────┬────────────┬────────────┬───────────┬───────────┬──────┐
// │      │     Q     │     W     │     E      │     R      │  T  │       │  Y  │     U      │     I      │     O     │     P     │      │
// ├──────┼───────────┼───────────┼────────────┼────────────┼─────┤       ├─────┼────────────┼────────────┼───────────┼───────────┼──────┤
// │      │ mt lgui A │ mt lalt S │ mt lctl D  │ mt lsft F  │  G  │       │  H  │ mt rsft J  │ mt rctl K  │ mt ralt L │ mt rgui ; │      │
// ├──────┼───────────┼───────────┼────────────┼────────────┼─────┤       ├─────┼────────────┼────────────┼───────────┼───────────┼──────┤
// │      │     Z     │     X     │     C      │     V      │  B  │       │  N  │     M      │     ,      │     .     │     /     │      │
// └──────┴───────────┴───────────┼────────────┼────────────┼─────┤       ├─────┼────────────┼────────────┼───────────┴───────────┴──────┘
//                                │    ESC     │   mo 1     │ TAB │       │ ENT │ lt 2 SPC   │ lt 3 BSPC  │
//                                └────────────┴────────────┴─────┘       └─────┴────────────┴────────────┘
   &trans   &kp Q        &kp W        &kp E          &kp R          &kp T        &kp Y      &kp U          &kp I        &kp O        &kp P          &trans
   &trans   &mt LGUI A   &mt LALT S   &mt LCTRL D    &mt LSHIFT F   &kp G        &kp H      &mt RSHIFT J   &mt RCTRL K  &mt RALT L   &mt RGUI SEMI  &trans
   &trans   &kp Z        &kp X        &kp C          &kp V          &kp B        &kp N      &kp M          &kp COMMA    &kp DOT      &kp FSLH       &trans
                                      &kp ESC        &mo LOWER      &kp TAB      &kp ENTER  &lt RAISE SPACE    &lt ADJUST BSPC
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
// ┌───────┬───────┬───────┬───────┬───────┬───────┐       ┌───────┬───────┬───────┬───────┬───────┬───────┐
// │       │   `   │   [   │   {   │   \   │   -   │       │   =   │   /   │   }   │   ]   │  SQT  │       │
// ├───────┼───────┼───────┼───────┼───────┼───────┤       ├───────┼───────┼───────┼───────┼───────┼───────┤
// │       │ LGUI  │ LALT  │ LCTL  │ LSFT  │  DEL  │       │ LEFT  │ DOWN  │  UP   │ RIGHT │ RSFT  │       │
// ├───────┼───────┼───────┼───────┼───────┼───────┤       ├───────┼───────┼───────┼───────┼───────┼───────┤
// │       │  F1   │  F2   │  F3   │  F4   │  F5   │       │  F6   │  F7   │  F8   │  F9   │  F10  │       │
// └───────┴───────┴───────┼───────┼───────┼───────┤       ├───────┼───────┼───────┼───────┴───────┴───────┘
//                         │       │       │       │       │       │       │       │
//                         └───────┴───────┴───────┘       └───────┴───────┴───────┘
   &trans   &kp GRAVE   &kp LBKT   &kp LBRC   &kp BSLH   &kp MINUS       &kp EQUAL   &kp FSLH   &kp RBRC   &kp RBKT   &kp SQT     &trans
   &trans   &kp LGUI    &kp LALT   &kp LCTRL  &kp LSHIFT &kp DEL         &kp LEFT    &kp DOWN   &kp UP     &kp RIGHT  &kp RSHIFT  &trans
   &trans   &kp F1      &kp F2     &kp F3     &kp F4     &kp F5          &kp F6      &kp F7     &kp F8     &kp F9     &kp F10     &trans
                                   &trans     &trans     &trans           &trans      &trans     &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
// ┌───────┬───────┬───────┬───────┬───────┬───────┐       ┌───────┬───────┬───────┬───────┬───────┬───────┐
// │       │   1   │   2   │   3   │   4   │   5   │       │   6   │   7   │   8   │   9   │   0   │       │
// ├───────┼───────┼───────┼───────┼───────┼───────┤       ├───────┼───────┼───────┼───────┼───────┼───────┤
// │       │ LGUI  │ LALT  │ LCTL  │ LSFT  │       │       │       │ RSFT  │ RCTL  │ RALT  │ RGUI  │       │
// ├───────┼───────┼───────┼───────┼───────┼───────┤       ├───────┼───────┼───────┼───────┼───────┼───────┤
// │       │       │ HOME  │ PG_UP │ PG_DN │  END  │       │       │       │       │       │       │       │
// └───────┴───────┴───────┼───────┼───────┼───────┤       ├───────┼───────┼───────┼───────┴───────┴───────┘
//                         │       │       │       │       │  ENT  │       │       │
//                         └───────┴───────┴───────┘       └───────┴───────┴───────┘
   &trans   &kp N1    &kp N2     &kp N3     &kp N4      &kp N5          &kp N6    &kp N7     &kp N8    &kp N9     &kp N0    &trans
   &trans   &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHIFT  &trans          &trans    &kp RSHIFT &kp RCTRL &kp RALT   &kp RGUI  &trans
   &trans   &trans    &kp HOME   &kp PG_UP  &kp PG_DN   &kp END         &trans    &trans     &trans    &trans     &trans    &trans
                                 &trans     &trans      &trans           &kp ENTER &trans     &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
// ┌──────┬──────┬────────┬────────┬────────┬────────┐       ┌───────┬──────────┬──────────┬───────────┬───────────┬──────┐
// │      │      │        │        │        │        │       │       │          │          │           │           │      │
// ├──────┼──────┼────────┼────────┼────────┼────────┤       ├───────┼──────────┼──────────┼───────────┼───────────┼──────┤
// │      │      │ BT_SEL2│ BT_SEL1│ BT_SEL0│ BT_CLR │       │ C_PP  │ C_VOL_UP │ C_VOL_DN │  C_NEXT   │  C_PREV   │      │
// ├──────┼──────┼────────┼────────┼────────┼────────┤       ├───────┼──────────┼──────────┼───────────┼───────────┼──────┤
// │      │ BOOT │ RESET  │        │ STUDIO │SOFT_OFF│       │       │          │          │   RESET   │   BOOT    │      │
// └──────┴──────┴────────┼────────┼────────┼────────┤       ├───────┼──────────┼──────────┼───────────┴───────────┴──────┘
//                        │        │        │        │       │       │          │          │
//                        └────────┴────────┴────────┘       └───────┴──────────┴──────────┘
   &trans   &rgb_ug RGB_TOG &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &rgb_ug RGB_EFF   &rgb_ug RGB_EFR &rgb_ug RGB_BRD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &none    &trans
   &trans   &none         &bt BT_SEL 2   &bt BT_SEL 1   &bt BT_SEL 0   &bt BT_CLR         &kp C_PP  &kp C_VOL_UP   &kp C_VOL_DN   &kp C_NEXT   &kp C_PREV    &trans
   &trans   &bootloader   &sys_reset     &none          &studio_unlock &soft_off          &none     &none          &none          &sys_reset   &bootloader   &trans
                                         &trans         &trans         &trans             &trans    &trans         &trans
            >;
        };
    };
};

